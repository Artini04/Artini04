{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"**/*"
	],
	"exclude": [
		"dist"
	],
	"compilerOptions": {
		"paths": {
			"@data/*": [
				"./src/data/*"
			],
			"@components/*": [
				"./src/components/*"
			],
			"@layouts/*": [
				"./src/layouts/*"
			]
		}
	}
}