{
	"arrowParens": "always",
	"bracketSameLine": true,
	"bracketSpacing": true,
	"experimentalOperatorPosition": "start",
	"experimentalTernaries": true,
	"htmlWhitespaceSensitivity": "css",
	"objectWrap": "collapse",
	"printWidth": 100,
	"proseWrap": "always",
	"quoteProps": "as-needed",
	"semi": false,
	"singleAttributePerLine": true,
	"singleQuote": true,
	"tabWidth": 4,
	"trailingComma": "all",
	"useTabs": true
}