---
import { Image } from "astro:assets"

interface Props {
	src: string
	alt?: string
	location?: string
	caption?: string
	date?: string
	id: number
}

const {
	src,
	alt = "No alt given.",
	location = "",
	caption = "",
	date = "",
	id,
} = Astro.props
const hasDesc = caption || location || date ? true : false
---

<div class="photo" data-id={id}>
	<div class="photo-cover">
		<Image
			class="photo__img"
			src={src}
			alt={alt}
			loading="lazy"
			width={1920}
			height={1080}
		/>
	</div>
	{
		hasDesc && (
			<div class="photo-content">
				<div class="photo__overlay" />

				{caption && <p class="photo__caption">{caption}</p>}
				{location && (
					<p class="photo__location" data-icon="📍">
						{location}
					</p>
				)}
				{date && (
					<p class="photo__date" data-icon="📅">
						{date}
					</p>
				)}
			</div>
		)
	}
</div>

<style lang="scss">
	.photo {
		overflow: clip;
		border: var(--global-border);
		border-radius: var(--global-border-radius);

		display: grid;
		grid-template-areas: "stack";
		cursor: pointer;
		user-select: none;

		&-cover,
		&-content {
			grid-area: stack;
			position: relative;
			isolation: isolate;
		}

		&-content {
			display: flex;
			flex-flow: column nowrap;
			place-content: flex-end;
			padding: 1em;
		}

		&__img {
			width: 100%;
			height: 100%;
			max-height: 250px;
			object-fit: cover;

			@container (width <= 600px) {
				max-height: fit-content;
			}
		}

		&__overlay {
			position: absolute;
			inset: 0;
			z-index: -1;
			background: linear-gradient(
				to bottom,
				hsl(0, 0%, 10%, 0) 60%,
				hsl(0, 0%, 10%, 0.8) 100%
			);
		}

		&__caption {
			font-weight: bold;
		}

		&__location,
		&__date {
			font-size: 0.8em;

			&::before {
				content: attr(data-icon);
				margin-inline-end: 0.4em;
			}
		}
	}
</style>

<script>
	document.addEventListener("click", (e) => {
		const target = e.target as Element
		const photo = target.closest(".photo") as HTMLDivElement | null
		if (!photo) return

		const img = photo.querySelector("img") as HTMLImageElement
		const captionEl = photo.querySelector(".photo__caption") as HTMLElement
		const locationEl = photo.querySelector(
			".photo__location",
		) as HTMLElement
		const dateEl = photo.querySelector(".photo__date") as HTMLElement

		const event = new CustomEvent("photo-view", {
			bubbles: true,
			detail: {
				src: img.src,
				alt: img.alt,
				caption: captionEl?.textContent || "",
				location: locationEl?.textContent || "",
			},
		})

		photo.dispatchEvent(event)
	})
</script>
