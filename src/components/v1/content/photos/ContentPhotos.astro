---
import Section from "@components/v1/section/Section.astro"
import Photo from "./Photo.astro"

import PHOTOS from "@data/photos.json"
---

<Section id="section-photos" class="section-photos">
	<div class="section-photos-heading">
		<div class="section-photo-heading-title">
			<h2>写真</h2>
			<h3>Photography</h3>
		</div>

		<div class="section-photos-gear">
			<p data-icon="📷">Canon EOS Rebel T7</p>
			<p data-icon="📷">Canon EF-s 55-250mm f/4-5.6 IS STM</p>
			<p data-icon="📦">Rawtherapee / ART, Upscayl</p>
		</div>

		<div class="section-photos-info">
			<p class="section-photos-info--info" data-icon="🎏">
				Will change to higher quality images...
			</p>
		</div>
	</div>

	<div class="section-photos-content">
		{
			PHOTOS.map((photo, index) => (
				<Photo
					id={index}
					src={photo.src}
					alt={photo.alt}
					caption={photo.caption}
					location={photo.location}
					date={photo.date}
				/>
			))
		}

		<div class="section-photos-content__filler"></div>
	</div>

	<div id="photo-modal" class="section-photos-modal" hidden>
		<div class="section-photos-modal--overlay" data-action="close"></div>
		<div class="section-photos-modal--content">
			<img class="section-photos-modal__img" src="" alt="" />
		</div>
	</div>
</Section>

<script>
	import type { PhotoEventDetail } from "@utils/types/photoView"

	const modal = document.getElementById("photo-modal")! as HTMLDivElement
	const modalImg = modal.querySelector(
		".section-photos-modal__img",
	) as HTMLImageElement

	document.addEventListener("photo-view", (e) => {
		const { src, alt } = (e as CustomEvent).detail as PhotoEventDetail

		modalImg.src = src
		modalImg.alt = alt
		modal.hidden = false

		document.body.style.overflow = "hidden"
	})

	modal.addEventListener("click", (e) => {
		modal.hidden = true
		document.body.style.overflow = ""
	})

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && !modal.hidden) {
			modal.hidden = true
			document.body.style.overflow = ""
		}
	})
</script>

<style lang="scss" is:global>
	.section-photos {
		&-content > * {
			flex: 1 1 auto;
		}
	}
</style>

<style lang="scss">
	@use "@styles/modules/layouts";

	.section-photos {
		&-heading {
			@extend %grid-content;
		}

		&-content {
			@extend %grid-break;

			display: flex;
			gap: 0.4em;
			flex-flow: row wrap;

			@container (width <= 600px) {
				flex-flow: column nowrap;
			}
		}

		&-gear {
			display: flex;
			flex-flow: row wrap;
			gap: 0 1.4em;

			& p::before {
				//content: "\2299";
				content: attr(data-icon);
				margin-inline-end: 1ch;
			}
		}

		&-content__filler {
			flex: 99 1 auto;

			@container (width <= 600px) {
				display: none;
			}
		}
	}

	.section-photos-info {
		color: hsl(0, 0%, 50%);

		&--info::before {
			content: attr(data-icon);
			margin-inline-end: 1ch;
		}
	}

	.section-photos-modal {
		position: fixed;
		inset: 0;
		z-index: 100;

		height: 100svh;
		padding: 4rem;
		backdrop-filter: blur(5px);
		transition: opacity ease-in-out 150ms;

		&:not([hidden]) {
			display: grid;
			grid-template-areas: "stack";

			background-color: hsla(0, 0%, 0%, 0.4);
			opacity: 1;

			@starting-style {
				opacity: 0;
			}
		}

		&--overlay,
		&--content {
			grid-area: stack;
			overflow: hidden;
		}

		&__img {
			width: 100%;
			height: 100%;

			object-fit: contain;
		}
	}
</style>
