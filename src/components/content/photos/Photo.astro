---
import { Image } from 'astro:assets'

interface Props {
	src: string
	alt?: string
	location?: string
	caption?: string
	date?: string
	id: number
}

const { src, alt = 'No alt given.', location = '', caption = '', date = '', id } = Astro.props
const hasDescription = Boolean(caption || location || date)
---

<div
	class="photo"
	data-id={id}>
	<div class="photo-media">
		<Image
			class="photo__img"
			src={src}
			alt={alt}
			loading="lazy"
			width={1920}
			height={1920}
		/>
	</div>
	{
		hasDescription && (
			<div class="photo-info | font-mplus">
				<div class="photo__overlay" />

				{caption && <p class="photo-info__caption">{caption}</p>}
				{location && (
					<p
						class="photo-info__location"
						data-icon="📍">
						{location}
					</p>
				)}
				{date && (
					<p
						class="photo-info__date"
						data-icon="📅">
						{date}
					</p>
				)}
			</div>
		)
	}
</div>

<style lang="scss">
	.photo {
		overflow: hidden;
		border: var(--comp-border);
		border-radius: var(--comp-border-radius);
		background: hsl(0 0% 5%);

		display: grid;
		grid-template-areas: 'stack';
		user-select: none;

		&-media,
		&-info {
			grid-area: stack;
			position: relative;
			isolation: isolate;
		}

		&-info {
			display: flex;
			flex-flow: column nowrap;
			place-content: flex-end;
			gap: 0.2rem 0;
			padding: 1rem;

			& p {
				text-shadow: 1px 1px hsl(0 0% 5% / 0.4);
			}

			&__caption {
				font-weight: bold;
			}

			&__location,
			&__date {
				font-size: 0.8em;
			}
		}

		&__img {
			width: 100%;
			height: 100%;
			object-fit: cover;

			@container (width <= 600px) {
				max-height: fit-content;
			}
		}

		&__overlay {
			position: absolute;
			inset: 0;
			z-index: -1;

			background: linear-gradient(to top, hsl(0 0% 5% / 0.8) 5%, hsl(0 0% 5% / 0) 40%);
		}
	}
</style>
