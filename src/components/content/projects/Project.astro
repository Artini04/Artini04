---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import ProjectTypeContainer from './type/ProjectTypeContainer.astro'
import ProjectType from './type/ProjectType.astro'
import ProjectLinksContainer from './links/ProjectLinksContainer.astro'
import ProjectLink from './links/ProjectLink.astro'

interface Props {
	title: string
	description: string
	links: { label: string; href: string; icon?: string }[]
	type?: string[]
	typeIcon?: string[]
	pinned?: boolean

	coverImg?: string
	coverAlt?: string
}

const {
	title,
	description,
	links,
	type,
	typeIcon,
	pinned = false,
	coverImg,
	coverAlt = 'No alt provided!',
} = Astro.props
---

<div
	class="project"
	data-pinned={pinned}>
	<div class="project-media">
		{!coverImg ?
			<div class:list={'project-media__img-none'}>No Image provided!</div>
		:	<Image
				class:list={'project-media__img'}
				src={coverImg}
				alt={coverAlt}
				loading="eager"
				width={1024}
				height={1024}
			/>
		}
	</div>

	<div class="project-info">
		<p class="project-info__title">{title}</p>
		<div class="project-info__description">{description}</div>

		<div class="project-info-actions">
			<ProjectTypeContainer>
				{!!typeIcon && typeIcon.map((item) => <Icon name={item} />)}
			</ProjectTypeContainer>

			<ProjectLinksContainer>
				{links.map(({ label, href, icon }) => (
					<ProjectLink
						link={href}
						label={label}
						icon={icon}
					/>
				))}
			</ProjectLinksContainer>
		</div>
	</div>
</div>

<style lang="scss">
	@use '../../../styles/module/utils';

	$project-media-size: 30%;

	.project {
		display: flex;
		flex-flow: row nowrap;
		overflow: hidden;

		border-radius: var(--comp-border-radius);
		background-color: var(--comp-background-color);
		box-shadow: var(--comp-box-shadow);

		&[data-pinned='true'] {
			order: 0;
		}

		@container (width <= 600px) {
			flex-flow: column nowrap;
		}
	}

	.project-media {
		flex: 1 1 $project-media-size;

		&__img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			@container (width <= 600px) {
				height: 150px;
			}
		}
	}

	.project-info {
		flex: 1 1 calc(100% - $project-media-size);

		display: flex;
		flex-flow: column nowrap;
		gap: 1rem 0;

		padding: 1rem;

		&__title {
			font-weight: bolder;
			font-size: 1.2em;
			text-transform: uppercase;
			text-wrap: balance;
		}

		&__description {
			flex: 1 1 auto;
			color: var(--global-app-font-color--secondary);
		}
	}

	.project-info-actions {
		display: flex;
		flex-flow: row nowrap;
		gap: 1rem;
		place-items: flex-end;
		place-content: center;
	}
</style>
