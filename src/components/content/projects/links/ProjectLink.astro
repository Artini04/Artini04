---
import { Icon } from 'astro-icon/components'

interface Props {
	link: string
	label: string
	icon?: string
}

const { link, label, icon = 'tabler:link' } = Astro.props
---

<a
	href={link}
	class="project-link"
	target="_blank">
	<Icon name={icon} />
	<span>{label}</span>
</a>

<style lang="scss">
	@use '../../../../styles/module/utils';

	.project-link {
		display: flex;
		flex-flow: row nowrap;
		gap: 0 0.5ch;

		place-items: center;
		place-content: center;

		color: var(--global-app-font-color--muted);

		@include utils.use-transition('color');
		@include utils.on-hover() {
			color: var(--global-app-font-color);
		}
	}
</style>
