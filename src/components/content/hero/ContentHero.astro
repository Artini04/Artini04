---
import { Image } from 'astro:assets'

import ActionLinkExternal from '@components/action/ActionLinkExternal.astro'
import BaseSection from '@components/base/section/BaseSection.astro'
---

<BaseSection
	id="section-hero"
	class={['content-hero']}>
	<div class="content-hero-display">
		<h1 class="content-hero-display__title">Artini04</h1>
		<div class="hero-label-list">
			<p class="hero-label-list__desc | text-lh-norm">
				Heya! Welcome to my personal website. I'm a web developer and currently learning
				Japanese. I'm one of the few people that still code CSS manually instead of using
				frameworks like Tailwind or using LLMs because, for me, CSS never was a problem.
			</p>
		</div>
		<div class="hero-link-list">
			<ActionLinkExternal
				link="https://github.com/Artini04"
				label="[GitHub]"
			/>
		</div>
	</div>
</BaseSection>

<style
	lang="scss"
	is:global>
	@use '../../../styles/module/layouts';

	$hero-max-size: 60svh;
	$hero-overlay-color: var(--global-app-background-color);

	.content-hero {
		height: $hero-max-size;
	}

	.content-hero-cover {
		@extend %grid-full;

		display: grid;
		grid-template-areas: 'stack';
		position: relative;

		user-select: none;

		&__cover,
		&__overlay {
			grid-area: stack;
		}

		&__cover {
			width: 100%;
			height: $hero-max-size;
			object-fit: cover;
			object-position: bottom center;
		}

		&__overlay {
			background: linear-gradient(to top, hsl(0 0% 10% / 1) 0%, hsl(0 0% 10% / 0) 50%);
		}
	}

	.content-hero-display {
		@extend %grid-content;

		display: flex;
		flex-flow: column nowrap;
		place-content: flex-end;

		& > div + div {
			margin-block-start: 0.4rem;
		}

		&__title {
			font-size: clamp(3em, 5vw, 4em);
			line-height: 1.1;
		}
	}

	.hero-label-list,
	.hero-link-list {
		display: flex;
		flex-flow: row wrap;
		gap: 0 1ch;
	}
</style>
