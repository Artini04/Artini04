---
import { Image } from 'astro:assets'

import ActionLinkExternal from '@components/action/ActionLinkExternal.astro'
import BaseSection from '@components/base/section/BaseSection.astro'
---

<BaseSection
	id="section-hero"
	class={['content-hero']}>
	<div class="content-hero-cover">
		<Image
			class:list={'content-hero-cover__cover'}
			src="/Artini04/cover/cover-2.webp"
			alt="Picture of a lamp post overlooking an afternoon sky."
			loading="eager"
			width={1920}
			height={1080}
		/>
		<div class="content-hero-cover__overlay"></div>
	</div>
	<div class="content-hero-display">
		<h1 class="content-hero-display__title">Artini04</h1>
		<div class="hero-label-list">
			<p>Web Developer</p>
			<p>日本語勉強</p>
		</div>
		<div class="hero-link-list">
			<ActionLinkExternal
				link="https://github.com/Artini04"
				label="[GitHub]"
			/>
		</div>
	</div>
</BaseSection>

<style lang="scss" is:global>
	@use '../../../styles/module/layouts';

	.content-hero-cover {
		@extend %grid-full;

		display: grid;
		grid-template-areas: 'stack';
		position: relative;

		&__cover,
		&__overlay {
			grid-area: stack;
		}

		&__cover {
			width: 100%;
			height: 50svh;
			object-fit: cover;
			object-position: bottom center;
		}

		&__overlay {
			background: linear-gradient(to top, hsl(0 0% 10% / 1) 0%, hsl(0 0% 10% / 0) 50%);
		}
	}

	.content-hero-display {
		@extend %grid-content;

		& > div + div {
			margin-block-start: 0.4rem;
		}

		&__title {
			font-size: clamp(3em, 5vw, 4em);
			line-height: 1.1;
		}
	}

	.hero-label-list,
	.hero-link-list {
		display: flex;
		flex-flow: row wrap;
		gap: 0 1ch;
	}

	.hero-link-list {
		font-size: 0.8em;
	}
</style>
