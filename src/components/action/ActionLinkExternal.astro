---
interface Props {
	link: string
	label: string
}

const { link, label } = Astro.props
---

<a
	class:list={['action-link-external']}
	href={link}
	target="_blank">
	<span>{label}</span>
</a>

<style lang="scss">
	.action-link-external {
		color: lightcoral;
		text-underline-offset: 5px;
	}
</style>
