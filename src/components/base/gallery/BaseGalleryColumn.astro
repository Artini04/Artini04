---
interface Props {
	class?: string[]
	columnMaxNum?: number
}

const { class: className = [], columnMaxNum = 4 } = Astro.props
---

<div
	class:list={['base-gallery-column', className]}
	style={`--column-max-number: ${columnMaxNum}`}>
	<slot />
</div>

<style
	lang="scss"
	is:global>
	$column-gap: 1rem;

	.base-gallery-column {
		columns: 30ch var(--column-max-number);
		column-gap: $column-gap;

		& > * + * {
			margin-block-start: $column-gap;
		}
	}
</style>
